---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`ページが見つかりません | ${SITE_TITLE}`} description="お探しのページは見つかりませんでした。" />
    <meta name="robots" content="noindex" />
    <style>
      body {
        font-family: -apple-system, 'Helvetica Neue', sans-serif;
        color: #111;
        background: #fff;
        margin: 0;
        padding: 0;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
      }
      h1 {
        font-size: 1.5rem;
      }
      a {
        color: #111;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>ページが見つかりません</h1>
      <p>お探しのページは、移動したか削除された可能性があります。</p>
      <p><a href="/">トップページへ戻る</a> ／ <a href="/blog/">記事一覧を見る</a></p>
    </main>
    <Footer />
  </body>
</html>
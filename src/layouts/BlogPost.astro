---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, coverImage } = Astro.props;

/* ── 記事下ナビ用のデータ準備 ── */
// 全記事を「新しい順」に並べる
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Astroのバージョン差(slug / id)を吸収するヘルパー
const slugOf = (p: any) => p.slug ?? p.id;

// 表示中の記事を、URLから特定する
const path = Astro.url.pathname.replace(/\/$/, '');
const index = allPosts.findIndex((p) => path.endsWith('/' + slugOf(p)));
const current = index >= 0 ? allPosts[index] : undefined;

// リンクのURLを組み立てる(現在のURLの階層をそのまま流用)
const base = current ? path.slice(0, path.length - slugOf(current).length) : '/blog/';
const urlFor = (p: any) => `${base}${slugOf(p)}/`;

// 新しい順に並んでいるので、1つ前 = 新しい記事 / 1つ後 = 前の記事
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older =
	index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : undefined;

// 新着5本(表示中の記事は除く)
const recentPosts = allPosts
	.filter((p) => !current || slugOf(p) !== slugOf(current))
	.slice(0, 5);
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			/* ── 記事コンテナ ── */
			.prose {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}

			/* ── タイトル部分 ── */
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: left;
			}
			.title h1 {
				font-size: 1.5em;
				font-weight: 700;
				line-height: 1.4;
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* ── 記事本文のタイポグラフィ ── */
			.prose :global(h2) {
				font-size: 1.3em;
				font-weight: 700;
				margin: 2.5em 0 0.8em;
				padding-bottom: 0.3em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.prose :global(h3) {
				font-size: 1.15em;
				font-weight: 700;
				margin: 2em 0 0.6em;
			}
			.prose :global(h4) {
				font-size: 1.05em;
				font-weight: 700;
				margin: 1.5em 0 0.5em;
			}
			.prose :global(p) {
				margin-bottom: 1.5em;
				line-height: 1.9;
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin-bottom: 1.5em;
				padding-left: 1.5em;
			}
			.prose :global(li) {
				margin-bottom: 0.4em;
				line-height: 1.8;
			}

			/* ── 画像 ── */
			.prose :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 2em auto;
				border-radius: 8px;
			}
			/* Markdownの ![alt](src) は <p><img></p> になるので余白調整 */
			.prose :global(p:has(> img)) {
				margin-bottom: 0.5em;
			}
			/* 画像キャプション: 画像直後の em を中央寄せキャプションに */
			.prose :global(p:has(> img) + p > em:only-child) {
				display: block;
				text-align: center;
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin-top: -0.5em;
				margin-bottom: 2em;
			}

			/* ── blockquote ── */
			.prose :global(blockquote) {
				border-left: 4px solid var(--accent);
				padding: 0.5em 0 0.5em 1.2em;
				margin: 1.5em 0;
				font-style: italic;
				color: rgb(var(--gray));
				font-size: 1em;
				background: rgba(var(--gray-light), 0.3);
				border-radius: 0 6px 6px 0;
			}
			.prose :global(blockquote p) {
				margin-bottom: 0.5em;
			}
			.prose :global(blockquote p:last-child) {
				margin-bottom: 0;
			}

			/* ── テーブル ── */
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.5em 0;
				font-size: 0.92em;
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.6em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				text-align: left;
			}
			.prose :global(th) {
				background: rgba(var(--gray-light), 0.5);
				font-weight: 700;
			}

			/* ── 区切り線 ── */
			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgb(var(--gray-light));
				margin: 2.5em 0;
			}

			/* ── 記事下ナビゲーション ── */
			.post-nav {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 2em auto 4em;
				padding: 0 1em;
			}
			.pager {
				display: flex;
				gap: 1em;
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 1.5em;
			}
			.pager-item {
				flex: 1 1 0;
				min-width: 0;
				display: block;
				padding: 0.9em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				background: rgba(var(--gray-light), 0.25);
				transition: background 0.2s ease;
			}
			a.pager-item:hover {
				background: rgba(var(--gray-light), 0.6);
			}
			.pager-item.empty {
				border: none;
				background: none;
			}
			.pager-label {
				display: block;
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-bottom: 0.3em;
			}
			.pager-item.next {
				text-align: right;
			}
			.pager-title {
				display: block;
				font-size: 0.95em;
				line-height: 1.5;
			}
			.recent {
				margin-top: 3em;
			}
			.recent-heading {
				font-size: 1.05em;
				font-weight: 700;
				margin: 0 0 0.8em;
				padding-bottom: 0.3em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.recent ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.recent li {
				padding: 0.6em 0;
				border-bottom: 1px dashed rgb(var(--gray-light));
			}
			.recent a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
				line-height: 1.6;
			}
			.recent a:hover {
				color: var(--accent);
			}
			.recent-date {
				display: block;
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			@media (max-width: 640px) {
				.pager {
					flex-direction: column;
				}
				.pager-item.next {
					text-align: left;
				}
				.pager-item.empty {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{coverImage && (
					<div class="hero-image">
						<Image src={coverImage} alt={title} />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>

			<nav class="post-nav" aria-label="記事ナビゲーション">
				<div class="pager">
					{
						older ? (
							<a class="pager-item prev" href={urlFor(older)}>
								<span class="pager-label">← 前の記事</span>
								<span class="pager-title">{older.data.title}</span>
							</a>
						) : (
							<span class="pager-item empty" />
						)
					}
					{
						newer ? (
							<a class="pager-item next" href={urlFor(newer)}>
								<span class="pager-label">次の記事 →</span>
								<span class="pager-title">{newer.data.title}</span>
							</a>
						) : (
							<span class="pager-item empty" />
						)
					}
				</div>

				<div class="recent">
					<h2 class="recent-heading">最近の記事</h2>
					<ul>
						{
							recentPosts.map((p) => (
								<li>
									<a href={urlFor(p)}>{p.data.title}</a>
									<span class="recent-date">
										<FormattedDate date={p.data.pubDate} />
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</nav>
		</main>
		<Footer />
	</body>
</html>